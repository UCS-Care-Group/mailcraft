#. interface
#: crates/ui-egui/src/credits.rs
msgid "ΔLines"
msgstr "Δשורות"

#. what a command says
#: crates/engine/src/cmd/compose.rs
msgid "“{subject}” came from its server but couldn't be kept on this computer, so it can't be forwarded as an attachment"
msgstr "\"{subject}\" הגיעה מהשרת שלה אך לא ניתן היה לשמור אותה במחשב זה, ולכן אי אפשר להעביר אותה כקובץ מצורף"

#. what a command says
#: crates/engine/src/cmd/compose.rs
msgid "“{subject}” isn't downloaded yet: open it once you're online, then forward it as an attachment"
msgstr "\"{subject}\" טרם הורדה: פתח אותה כשתהיה מחובר לרשת, ולאחר מכן העבר אותה כקובץ מצורף"

#. what a command says
#: crates/engine/src/sync_driver/as_received.rs
msgid "“{subject}” isn't downloaded yet: open it once you're online, then save it"
msgstr "\"{subject}\" טרם הורדה: פתח אותה כשתהיה מחובר לרשת, ולאחר מכן שמור אותה"

#. what a command says
#: crates/engine/src/cmd/compose.rs
msgid "“{subject}” was too large to download: only its header is here, so it can't be forwarded as an attachment"
msgstr "\"{subject}\" הייתה גדולה מדי להורדה: רק הכותרת שלה נמצאת כאן, ולכן אי אפשר להעביר אותה כקובץ מצורף"

#. what a command says
#: crates/engine/src/cmd/file.rs crates/engine/src/sync_driver/as_received.rs
msgid "“{subject}” was too large to download: only its header is here, so it can't be saved as a message"
msgstr "\"{subject}\" הייתה גדולה מדי להורדה: רק הכותרת שלה נמצאת כאן, ולכן אי אפשר לשמור אותה כהודעה"

#. what a command says
#: crates/engine/src/cmd/compose.rs
msgid "“{subject}” wasn't found on its server, so it can't be forwarded as an attachment"
msgstr "\"{subject}\" לא נמצאה בשרת שלה, ולכן אי אפשר להעביר אותה כקובץ מצורף"

