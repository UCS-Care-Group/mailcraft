#. what a command says
#: crates/engine/src/cmd/file.rs
msgid "a .pst file is being imported into this mailbox: wait for it to finish, then save to another place"
msgstr "קובץ ‎.pst מיובא כעת אל תיבת דואר זו: המתן לסיום התהליך, ולאחר מכן שמור למיקום אחר"

#. what a command says
#: crates/engine/src/import_pst.rs
msgid "a .pst file is imported into a calendar of your own on this computer only, never an account on a server or a subscribed calendar"
msgstr "קובץ ‎.pst מיובא ללוח שנה שלך במחשב זה בלבד, לעולם לא לחשבון בשרת או ללוח שנה במינוי"

#. what a command says
#: crates/engine/src/import_pst.rs
msgid "a .pst file is imported into a folder on this computer only, never an account on a server or an Outbox"
msgstr "קובץ ‎.pst מיובא לתיקייה במחשב זה בלבד, לעולם לא לחשבון בשרת או לתיבת דואר יוצא"

#. what a command says
#: crates/engine/src/cmd/account.rs
msgid "a JMAP account's server and address can't be changed once its mail is here: remove it and add the other one"
msgstr "אי אפשר לשנות את השרת ואת הכתובת של חשבון JMAP לאחר שהדואר שלו כבר כאן: הסר אותו והוסף את החשבון האחר"

#. what a command says
#: crates/engine/src/cmd/senders.rs
msgid "a Microsoft or Exchange account sends from other addresses only as its server allows, which MailCraft doesn't ask for yet"
msgstr "חשבון Microsoft או Exchange שולח מכתובות אחרות רק כפי שהשרת שלו מתיר, ו־MailCraft עדיין אינו מבקש הרשאה לכך"

#. why a mail server couldn't be used
#: crates/net/src/sync.rs
msgid "a Microsoft sign-in is only used with Microsoft's own mail servers: this account names another server"
msgstr "כניסה באמצעות Microsoft משמשת רק עם שרתי הדואר של Microsoft עצמה: חשבון זה מציין שרת אחר"

#. what a command says
#: crates/engine/src/cmd/calendar.rs
msgid "a calendar named \"{name}\" already exists"
msgstr "לוח שנה בשם \"{name}\" כבר קיים"

#. what a command says
#: crates/model/src/mailbox.rs
msgid "a category needs a name"
msgstr "קטגוריה צריכה שם"

#. what a command says
#: crates/model/src/rich.rs
msgid "a colour is written #rrggbb"
msgstr "צבע נכתב בתבנית ‎#rrggbb"

#. what a command says
#: crates/engine/src/cmd/people.rs crates/engine/src/cmd/people_merge.rs
msgid "a contact needs a name, a company or an e-mail address"
msgstr "איש קשר צריך שם, חברה או כתובת דוא״ל"

#. what a command says
#: crates/engine/src/cmd/keys.rs
msgid "a contact's card keeps at most 32 keys"
msgstr "כרטיס איש קשר שומר לכל היותר 32 מפתחות"

#. what a command says
#: crates/model/src/mailbox_followup.rs
msgid "a draft can't have a reminder: send it first, or use Follow Up in the message itself"
msgstr "לטיוטה לא יכולה להיות תזכורת: שלח אותה תחילה, או השתמש ב״המשך טיפול״ בהודעה עצמה"

#. what a command says
#: crates/model/src/mailbox.rs
msgid "a folder can't move into itself"
msgstr "תיקייה אינה יכולה לעבור לתוך עצמה"

#. what a command says
#: crates/model/src/mailbox.rs
msgid "a folder can't move to another account"
msgstr "תיקייה אינה יכולה לעבור לחשבון אחר"

#. what a command says
#: crates/model/src/mailbox.rs
msgid "a folder name can't contain /"
msgstr "שם תיקייה אינו יכול להכיל /"

#. what a command says
#: crates/model/src/mailbox.rs
msgid "a folder needs a name"
msgstr "תיקייה צריכה שם"

#. what a command says
#: crates/model/src/rich.rs crates/model/src/rich/body.rs
msgid "a link goes to an address like https://..., mailto:... or ms-settings:..., never javascript:, vbscript:, data: or file:"
msgstr "קישור מפנה לכתובת כגון https://..., mailto:... או ms-settings:..., לעולם לא javascript:, vbscript:, data: או file:"

#. what a command says
#: crates/engine/src/cmd/junk.rs
msgid "a list holds {n} entries at most"
msgstr "רשימה יכולה להכיל לכל היותר {n} ערכים"

#. what a command says
#: crates/model/src/mailbox_snooze.rs
msgid "a message being written or waiting to be sent can't be snoozed"
msgstr "לא ניתן לדחות הודעה שנמצאת בכתיבה או ממתינה לשליחה"

#. what a command says
#: crates/engine/src/session.rs
msgid "a message is saved in the background by the window's own timer alone"
msgstr "הודעה נשמרת ברקע אך ורק באמצעות הטיימר של החלון עצמו"

#. why a mail server couldn't be used
#: crates/proto/src/imap/mod.rs
msgid "a message that isn't on the server has no flags there"
msgstr "להודעה שאינה נמצאת בשרת אין שם דגלים"

#. what a command says
#: crates/model/src/mailbox.rs
msgid "a personal Microsoft account (Outlook.com) has no shared mailboxes: they are Microsoft 365's"
msgstr "לחשבון Microsoft אישי (Outlook.com) אין תיבות דואר משותפות: הן קיימות רק ב־Microsoft 365"

#. what a command says
#: crates/model/src/pictures.rs
msgid "a picture in a message is a PNG, JPEG, GIF or WebP file"
msgstr "תמונה בהודעה היא קובץ PNG, JPEG, GIF או WebP"

#. what a command says
#: crates/engine/src/cmd/picture.rs
msgid "a picture in a message is at most {mb} MB"
msgstr "גודל תמונה בהודעה הוא לכל היותר {mb} מ״ב"

#. what a command says
#: crates/engine/src/cmd/react.rs
msgid "a reaction can't be sent to a draft or to mail you wrote"
msgstr "לא ניתן לשלוח תגובה לטיוטה או לדואר שכתבת"

#. what a command says
#: crates/engine/src/cmd/react.rs
msgid "a reaction is sent only from IMAP, JMAP and local accounts, not from a Microsoft or Exchange server account"
msgstr "תגובה נשלחת רק מחשבונות IMAP, JMAP וחשבונות מקומיים, ולא מחשבון Microsoft או מחשבון שרת Exchange"

#. what a command says
#: crates/engine/src/cmd/react.rs
msgid "a reaction isn't sent to automated mail (a no-reply address, a mailing list, bulk mail)"
msgstr "תגובה אינה נשלחת לדואר אוטומטי (כתובת ללא מענה, רשימת תפוצה, דיוור המוני)"

#. what a command says
#: crates/engine/src/cmd/react.rs
msgid "a reaction isn't sent to mail in Junk E-mail"
msgstr "תגובה אינה נשלחת לדואר בתיקיית דואר זבל"

#. what a command says
#: crates/engine/src/cmd/auto_replies.rs
msgid "a reply may be {most} characters long at most"
msgstr "תשובה יכולה להכיל לכל היותר {most} תווים"

#. what a command says
#: crates/engine/src/cmd/rules.rs
msgid "a rule can't move mail to an Outbox: that would send it"
msgstr "כלל אינו יכול להעביר דואר לתיבת הדואר היוצא: הדבר ישלח אותו"

#. what a command says
#: crates/engine/src/cmd/rules.rs
msgid "a rule is for an account's own mail, not a shared mailbox's"
msgstr "כלל מיועד לדואר של החשבון עצמו, ולא של תיבת דואר משותפת"

#. what a command says
#: crates/engine/src/cmd/rules.rs
msgid "a rule of one account can't go to another account's server"
msgstr "כלל של חשבון אחד אינו יכול לעבור לשרת של חשבון אחר"

#. what a command says
#: crates/engine/src/cmd/rules.rs
msgid "a rule waiting to go to the server goes after those there; it can be moved once it is there"
msgstr "כלל הממתין לעבור לשרת ממוקם אחרי הכללים שכבר נמצאים שם; ניתן יהיה להזיז אותו לאחר שיגיע לשם"

#. interface, what a command says
#: crates/engine/src/cmd/senders.rs crates/ui-egui/src/account_setup/senders.rs
msgid "a sender address has no e-mail address"
msgstr "לכתובת שולח חסרה כתובת דוא״ל"

#. what a command says
#: crates/engine/src/cmd/account.rs
msgid "a shared mailbox asks before deleting a conversation as the account it is opened through does: change that account's"
msgstr "תיבת דואר משותפת שואלת לפני מחיקת שיחה בהתאם להגדרה של החשבון שדרכו היא נפתחת: שנה את ההגדרה של אותו חשבון"

#. what a command says
#: crates/model/src/mailbox.rs
msgid "a shared mailbox can't open another one: name the account it is opened through"
msgstr "תיבת דואר משותפת אינה יכולה לפתוח תיבה משותפת אחרת: ציין את החשבון שדרכו היא נפתחת"

#. what a command says
#: crates/model/src/mailbox_snooze.rs
msgid "a shared mailbox has no Snoozed folder"
msgstr "לתיבת דואר משותפת אין תיקיית הודעות שנדחו"

#. what a command says
#: crates/engine/src/cmd/account.rs
msgid "a shared mailbox keeps as much mail offline as the account it is opened through: change that account's"
msgstr "תיבת דואר משותפת שומרת במצב לא מקוון את אותה כמות דואר כמו החשבון שדרכו היא נפתחת: שנה את ההגדרה של אותו חשבון"

#. what a command says
#: crates/engine/src/cmd/offline.rs
msgid "a shared mailbox keeps as much mail offline as the account it is opened through: name that account"
msgstr "תיבת דואר משותפת שומרת במצב לא מקוון את אותה כמות דואר כמו החשבון שדרכו היא נפתחת: ציין את אותו חשבון"

#. what a command says
#: crates/model/src/mailbox.rs
msgid "a shared mailbox stays under the account it is opened through: move that account"
msgstr "תיבת דואר משותפת נשארת תחת החשבון שדרכו היא נפתחת: העבר את אותו חשבון"

#. what a command says
#: crates/engine/src/cmd/account.rs
msgid "a shared mailbox's address can't be changed: remove it and add the other one"
msgstr "לא ניתן לשנות את הכתובת של תיבת דואר משותפת: הסר אותה והוסף את האחרת"

#. what a command says
#: crates/engine/src/cmd/rules.rs
msgid "a shared mailbox's rules are its own: this version doesn't make them"
msgstr "כללי תיבת דואר משותפת שייכים לתיבה עצמה: גרסה זו אינה יוצרת אותם"

#. why a command can't run
#: crates/engine/src/cmd/picture.rs
msgid "a signature is open: add its pictures with signature.picture.add"
msgstr "חתימה פתוחה כעת: הוסף את התמונות שלה באמצעות signature.picture.add"

#. what a command says
#: crates/model/src/signature.rs
msgid "a signature's pictures are PNG, JPEG or GIF (many mail programs can't show other kinds)"
msgstr "תמונות של חתימה הן בפורמט PNG, JPEG או GIF (תוכנות דואר רבות אינן יכולות להציג סוגים אחרים)"

#. what a command says
#: crates/engine/src/cmd/tasks.rs
msgid "a task needs a title"
msgstr "משימה זקוקה לכותרת"

#. what a command says, why a command can't run
#: crates/engine/src/cmd/people.rs
msgid "add an Exchange server account first: its organisation's address list is searched"
msgstr "הוסף תחילה חשבון שרת Exchange: החיפוש מתבצע ברשימת הכתובות של הארגון שלו"

#. what a command says
#: crates/engine/src/cmd/folder.rs crates/engine/src/cmd/signature.rs
msgid "add an account first"
msgstr "הוסף תחילה חשבון"

#. what a command says
#: crates/engine/src/cmd/compose.rs crates/engine/src/cmd/ews_mail.rs
msgid "add an account first (File › Add Account)"
msgstr "הוסף תחילה חשבון (קובץ › הוסף חשבון)"

#. what a command says
#: crates/engine/src/cmd/compose.rs
msgid "add at least one recipient"
msgstr "הוסף נמען אחד לפחות"

#. what a command says
#: crates/engine/src/cmd/account.rs
msgid "an Exchange server account's server, address and user name can't be changed once its mail is here: remove it and add the other one"
msgstr "לא ניתן לשנות את השרת, הכתובת ושם המשתמש של חשבון שרת Exchange לאחר שהדואר שלו כבר כאן: הסר אותו והוסף את החשבון האחר"

#. what a command says
#: crates/model/src/signature.rs
msgid "an HTML signature shows pictures from their web address only: remove this signature's pictures first"
msgstr "חתימת HTML מציגה תמונות מכתובת האינטרנט שלהן בלבד: הסר תחילה את התמונות של חתימה זו"

#. what a command says
#: crates/model/src/signature.rs
msgid "an HTML signature shows pictures from their web address: switch it to rich text to add one"
msgstr "חתימת HTML מציגה תמונות מכתובת האינטרנט שלהן: העבר אותה לטקסט עשיר כדי להוסיף תמונה"

#. what a command says
#: crates/engine/src/digital_signature.rs
msgid "an S/MIME certificate is trusted through its certification authority and isn't marked Verified"
msgstr "אישור S/MIME מהימן דרך רשות האישורים שלו ואינו מסומן כמאומת"

#. what a command says
#: crates/engine/src/cmd/account.rs
msgid "an account becomes a JMAP account, or stops being one, only by being removed and added again"
msgstr "חשבון הופך לחשבון JMAP, או מפסיק להיות כזה, רק באמצעות הסרתו והוספתו מחדש"

#. what a command says
#: crates/engine/src/cmd/account.rs
msgid "an account becomes an Exchange server account, or stops being one, only by being removed and added again"
msgstr "חשבון הופך לחשבון שרת Exchange, או מפסיק להיות כזה, רק באמצעות הסרתו והוספתו מחדש"

#. what a command says
#: crates/model/src/mailbox.rs
msgid "an account can't be put before itself"
msgstr "לא ניתן למקם חשבון לפני עצמו"

#. interface, what a command says
#: crates/engine/src/cmd/senders.rs crates/ui-egui/src/account_setup/senders.rs
msgid "an account has {max} sender addresses at most"
msgstr "לחשבון יש לכל היותר {max} כתובות שולח"

#. what a command says
#: crates/engine/src/cmd/calendar.rs
msgid "an event needs a title"
msgstr "לאירוע דרושה כותרת"

#. interface
#: crates/ui-egui/src/forms.rs
msgid "and"
msgstr "וגם"

