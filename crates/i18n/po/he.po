#. what a command says
#: crates/engine/src/import_pst.rs
msgid "A .pst file is being imported: try again when it is done"
msgstr "מתבצע כעת ייבוא של קובץ .pst: נסו שוב בסיום הייבוא"

#. what a command says
#: crates/model/src/mailbox_snooze.rs
msgid "A JMAP account's mail can't be snoozed yet."
msgstr "עדיין לא ניתן להשהות דואר של חשבון JMAP."

#. interface
#: crates/ui-egui/src/reading/warnings.rs
msgid "A brand's name on another address."
msgstr "שם של מותג על כתובת זרה."

#. what a command says
#: crates/engine/src/sync_driver/calendar_plan.rs
msgid "A calendar change couldn't be sent yet and will be tried again: {error}"
msgstr "השינוי ביומן עדיין לא נשלח. המערכת תנסה שוב: {error}"

#. what a command says
#: crates/engine/src/sync_driver/calendar_plan.rs
msgid "A change to a shared mailbox's calendar was refused: this account may not edit it. It is tried once more, and then put back."
msgstr "שינוי בלוח השנה של תיבת דואר משותפת נדחה: ייתכן שלחשבון זה אין הרשאה לערוך אותו. יתבצע ניסיון אחד נוסף, ולאחר מכן הוא יוחזר לקדמותו."

#. interface
#: crates/ui-egui/src/symbol.rs
msgid "A code point written U+2192 or 2192, or a decimal number after #."
msgstr "נקודת קוד בכתיב U+2192 או 2192, או מספר עשרוני אחרי #."

#. interface
#: crates/ui-egui/src/backstage.rs
msgid "A colleague's calendar, by their address, with your work or school account. Kept on this computer only"
msgstr "לוח שנה של עמית, לפי כתובתו, באמצעות חשבון העבודה או בית הספר שלכם. נשמר במחשב זה בלבד"

#. interface
#: crates/ui-egui/src/forms.rs
msgid "A contact's card keeps at most 32 certificates and keys"
msgstr "כרטיס איש קשר שומר לכל היותר 32 אישורים ומפתחות"

#. what a command says
#: crates/model/src/mailbox.rs
msgid "A copy can't go into this Outbox: the next Send/Receive would send it"
msgstr "אי אפשר להכניס עותק לתיבת הדואר היוצא: פעולת השליחה והקבלה הבאה תשלח אותו."

#. interface
#: crates/ui-egui/src/graph_switch.rs
msgid "A copy of the mailbox is being saved for a switch already: wait for it to finish."
msgstr "עותק של תיבת הדואר כבר נשמר לצורך מעבר. יש להמתין לסיום השמירה."

#. interface
#: crates/ui-egui/src/graph_switch.rs
msgid "A copy of your whole mailbox is saved next to it first, as always. Mail in the Outbox isn't left behind: it is sent through Microsoft Graph."
msgstr "עותק של תיבת הדואר כולה נשמר לצידה תחילה, כרגיל. דואר שנמצא בתיבת הדואר היוצא אינו נשאר מאחור: הוא נשלח דרך Microsoft Graph."

#. interface
#: crates/ui-egui/src/reminder_dialog.rs
msgid "A date"
msgstr "תאריך"

#. android
#: apps/mailcraft-android/app/src/main/kotlin/work/mailcraft/android/ShareLoad.kt
msgid "A file"
msgstr "קובץ"

#. interface
#: crates/ui-egui/src/files.rs
msgid "A file dialog is already open."
msgstr "תיבת דו־שיח לבחירת קובץ כבר פתוחה."

#. interface
#: crates/ui-egui/src/security.rs
msgid "A key is marked Verified only in the dialog that shows its fingerprint, by you"
msgstr "מפתח מסומן כמאומת רק על ידכם, בתיבת הדו-שיח המציגה את טביעת האצבע שלו"

#. interface
#: crates/ui-egui/src/graph_switch.rs
msgid "A large mailbox takes a while. {account} switches to Microsoft Graph as soon as the copy is saved; nothing has changed yet."
msgstr "תיבת דואר גדולה לוקחת זמן מה. {account} יעבור ל-Microsoft Graph מיד לאחר שמירת העותק; דבר לא השתנה עדיין."

#. interface
#: crates/ui-egui/src/files.rs
msgid "A link asked for a new message, but the one you are writing couldn't be saved first: {why}"
msgstr "קישור ביקש לפתוח הודעה חדשה, אך לא ניתן היה לשמור תחילה את ההודעה שבכתיבה: {why}"

#. interface
#: crates/ui-egui/src/reading/warnings.rs
msgid "A link goes somewhere else."
msgstr "הקישור מוביל לכתובת אחרת."

#. interface
#: crates/ui-egui/src/reading/warnings.rs
msgid "A link that reads {named} goes to {host}."
msgstr "קישור שהטקסט שלו הוא {named} מוביל אל {host}."

#. interface
#: crates/ui-egui/src/reading/warnings.rs
msgid "A link whose text is mostly characters that aren't shown goes to {host}."
msgstr "קישור שהטקסט שלו מורכב בעיקר מתווים מוסתרים מוביל אל {host}."

#. interface
#: crates/ui-egui/src/reading/warnings.rs
msgid "A made-up domain."
msgstr "דומיין בדוי."

#. name
#: crates/ui-egui/src/account_setup.rs
msgid "A mail server your organisation runs itself"
msgstr "שרת דואר שהארגון שלך מפעיל בעצמו"

#. name
#: crates/ui-egui/src/account_setup.rs
msgid "A mailbox kept here, with no mail server"
msgstr "תיבת דואר מקומית, ללא שרת דואר"

#. interface
#: crates/ui-egui/src/shared_calendars.rs
msgid "A meeting answer or invitation from this shared mailbox waits: sending from shared mailboxes needs your permission. Use Send/Receive."
msgstr "תגובה להזמנה לפגישה או הזמנה חדשה מתיבת דואר משותפת זו ממתינה: שליחה מתיבות דואר משותפות מחייבת הרשאה. יש להשתמש בשלח/קבל."

#. what a command says
#: crates/engine/src/cmd/calendar/meeting.rs
msgid "A meeting can't be moved to another calendar: the account's server has no way of moving one, and making it again there would send everyone invited a cancellation and a new invitation."
msgstr "לא ניתן להעביר פגישה ללוח שנה אחר: לשרת של החשבון אין דרך להעביר אותה, ויצירתה מחדש שם תשלח לכל המוזמנים ביטול והזמנה חדשה."

#. what a command says
#: crates/engine/src/cmd/calendar/meeting.rs
msgid "A meeting can't be moved to another mailbox's calendar: that would send everyone invited a cancellation, and their replies would no longer reach it. Forward the meeting, or create it again in that calendar."
msgstr "לא ניתן להעביר פגישה ללוח השנה של תיבת דואר אחרת: פעולה זו תשלח לכל המוזמנים ביטול, ותגובותיהם לא יגיעו אליה עוד. העבירו את הפגישה הלאה, או צרו אותה מחדש באותו לוח שנה."

#. what a command says
#: crates/engine/src/cmd/calendar/meeting.rs
msgid "A meeting is forwarded to {n} people at most at once."
msgstr "פגישה מועברת ל-{n} אנשים לכל היותר בבת אחת."

#. interface
#: crates/ui-egui/src/reading/invitation.rs
msgid "A meeting on your calendar has this ID but another organizer, so this invitation can't change it."
msgstr "בלוח השנה שלכם קיימת פגישה עם מזהה זה אך עם מארגן אחר, ולכן הזמנה זו אינה יכולה לשנות אותה."

#. what a command says
