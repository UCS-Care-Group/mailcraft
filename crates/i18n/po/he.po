#: crates/ui-egui/src/reading/warnings.rs
msgid "The sender's domain, {domain}, looks made by a machine or can't exist: real organisations rarely send from one."
msgstr "הדומיין של השולח, {domain}, נראה כאילו נוצר באופן אוטומטי או שאינו יכול להתקיים: ארגונים אמיתיים שולחים מדומיין כזה לעיתים רחוקות בלבד."

#. interface
#: crates/ui-egui/src/reading/warnings.rs
msgid "The sender's name says {brand}, but this message came from {real}, and {domain} isn't one of {brand}'s domains."
msgstr "שם השולח מציין {brand}, אך הודעה זו הגיעה מ־{real}, והדומיין {domain} אינו אחד הדומיינים של {brand}."

#. interface
#: crates/ui-egui/src/reading/warnings.rs
msgid "The sender's name shows {shown}, but the message came from {real}."
msgstr "שם השולח מוצג כ־{shown}, אך ההודעה נשלחה מ־{real}."

