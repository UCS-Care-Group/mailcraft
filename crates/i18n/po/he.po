msgid "The {n} shared mailboxes opened through it are removed from this device too."
msgstr "{n} תיבות הדואר המשותפות שנפתחו דרכו מוסרות גם הן ממכשיר זה."

#. interface
#: crates/ui-egui/src/merge_contacts.rs
msgid "Their details are the same; the kept contact loses nothing."
msgstr "הפרטים שלהם זהים; לא יאבד מידע באיש הקשר שיישמר."

#. ribbon
#: crates/ui-egui/src/ribbon.rs
msgid "Theme"
msgstr "ערכת נושא"

#. interface
#: crates/ui-egui/src/forms.rs
msgid "Then run it over the mail already in {folder}"
msgstr "ולאחר מכן הפעל אותו על הדואר שכבר נמצא ב־{folder}"

#. interface
#: crates/ui-egui/src/data_removal.rs
msgid "There is no data folder to open here"
msgstr "אין כאן תיקיית נתונים שאפשר לפתוח"

#. interface
#: crates/ui-egui/src/updates.rs
msgid "There is no earlier version to go back to."
msgstr "אין גרסה קודמת לחזור אליה."

#. what a command says
#: crates/mobile/src/fetch.rs
msgid "There is no network connection."
msgstr "אין חיבור לרשת."

#. what a command says
#: crates/engine/src/cmd/calendar_settings.rs
msgid "There is no other calendar to lay it over."
msgstr "אין לוח שנה אחר להציג אותו מעליו."

#. interface
#: crates/ui-egui/src/signatures.rs
msgid "There is no picture on the clipboard."
msgstr "אין תמונה בלוח."

#. interface
#: crates/ui-egui/src/lib.rs
msgid "There is no such account"
msgstr "אין חשבון כזה"

#. interface
#: crates/ui-egui/src/reading/signature.rs
msgid "There's more in this Digital signature than MailCraft checks for one message."
msgstr "בחתימה דיגיטלית זו יש יותר תוכן מכפי ש־MailCraft בודק עבור הודעה אחת."

#. interface
#: crates/ui-egui/src/open_shared.rs
msgid "There's no mailbox at {address}, or its calendar can't be reached through Microsoft."
msgstr "אין תיבת דואר בכתובת {address}, או שלא ניתן להגיע ללוח השנה שלה דרך Microsoft."

#. interface
#: crates/ui-egui/src/shared_mailboxes.rs
msgid "There's no mailbox at {address}."
msgstr "לא נמצאה תיבת דואר בכתובת {address}."

#. ribbon
#: crates/ui-egui/src/ribbon.rs
msgid "Thesaurus"
msgstr "אגרון"

#. interface
#: crates/ui-egui/src/meeting_dialogs/share.rs
msgid "These are the answers this computer has been told of."
msgstr "אלה הן התשובות שמחשב זה עודכן לגביהן."

#. interface
#: crates/ui-egui/src/merge_contacts.rs
msgid "These contacts can't be merged here: fewer than two of them can be changed."
msgstr "אי אפשר למזג אנשי קשר אלה כאן: ניתן לערוך פחות משניים מהם."

#. interface
#: crates/ui-egui/src/data_removal.rs
msgid "These could not be removed. Remove them yourself:"
msgstr "לא ניתן היה להסיר את הפריטים הבאים. יש להסיר אותם ידנית:"

#. interface
#: crates/ui-egui/src/task_sync.rs
msgid "These tasks exist only on this computer. Choose the Microsoft account whose To Do gets them. Until you choose, they stay here and nothing of them is sent."
msgstr "משימות אלה קיימות רק במחשב זה. בחר את חשבון Microsoft שיקבל אותן ל־To Do שלו. עד שתבחר, הן נשארות כאן ודבר מהן אינו נשלח."

#. interface
#: crates/ui-egui/src/task_sync.rs
msgid "These tasks exist only on this computer. If you send them, they are kept in step with Microsoft To Do. Until you do, they stay here and nothing of them is sent. File › Info offers this again."
msgstr "משימות אלה קיימות רק במחשב זה. אם תשלח אותן, הן יישמרו מסונכרנות עם Microsoft To Do. עד שתעשה זאת, הן נשארות כאן ודבר מהן אינו נשלח. קובץ › מידע מציע אפשרות זו שוב."

#. interface
#: crates/ui-egui/src/data_removal.rs
msgid "These were left alone:"
msgstr "הפריטים הבאים לא שונו:"

#. interface
#: crates/ui-egui/src/reading/remote.rs
msgid "They are on the web, and fetching them would tell the sender that you opened this message."
msgstr "הן נמצאות באינטרנט, ואחזורן יודיע לשולח שפתחת הודעה זו."

#. interface
#: crates/ui-egui/src/dialogs.rs
msgid "They are removed from the mail server too, and that can't be undone."
msgstr "הם מוסרים גם משרת הדואר, ולא ניתן לבטל את הפעולה."

#. interface
#: crates/ui-egui/src/dialogs.rs
msgid "They are removed from the mail server too."
msgstr "הם מוסרים גם משרת הדואר."

#. interface
#: crates/ui-egui/src/report_problem.rs
msgid "They are saved to a file you choose, which you attach to the issue on GitHub. They are never put in the link."
msgstr "הם נשמרים לקובץ שתבחר, שאותו תצרף לדיווח (Issue) ב־GitHub. הם לעולם אינם נכללים בקישור."

#. interface
#: crates/ui-egui/src/merge_contacts.rs
msgid "They share {what}."
msgstr "הפרטים המשותפים להם: {what}."

#. name, ribbon
#: crates/ui-egui/src/ribbon.rs crates/ui-egui/src/tasks_view.rs
msgid "This Week"
msgstr "השבוע"

#. interface
#: crates/ui-egui/src/account_setup.rs
msgid "This account does not use Google sign-in."
msgstr "חשבון זה אינו משתמש בכניסה באמצעות Google."

#. what a command says
#: crates/engine/src/cmd/unsubscribe.rs
msgid "This account doesn't send mail from MailCraft, so it can't unsubscribe by mail."
msgstr "חשבון זה אינו שולח דואר מתוך MailCraft, ולכן אינו יכול לבטל מנוי בדוא״ל."

#. interface
#: crates/ui-egui/src/approval.rs crates/ui-egui/src/calendar_sync.rs crates/ui-egui/src/favorites_sync.rs crates/ui-egui/src/lib.rs
msgid "This account doesn't sign in with Microsoft"
msgstr "חשבון זה אינו מתחבר באמצעות Microsoft"

#. what a command says
#: crates/engine/src/cmd/calendar/invitation.rs
msgid "This account has no mail server to send the answer through."
msgstr "לחשבון זה אין שרת דואר שדרכו ניתן לשלוח את התשובה."

#. interface
#: crates/ui-egui/src/lib.rs crates/ui-egui/src/server_sync.rs crates/ui-egui/src/shared_mailboxes.rs
msgid "This account has no sign-in with Microsoft"
msgstr "לחשבון זה אין כניסה באמצעות Microsoft"

#. interface
#: crates/ui-egui/src/account_setup.rs
msgid "This account is no longer in the mailbox."
msgstr "חשבון זה אינו נמצא עוד בתיבת הדואר."

#. interface
#: crates/ui-egui/src/category_sync.rs
msgid "This account may not change its categories through Microsoft Graph"
msgstr "חשבון זה אינו מורשה לשנות את הקטגוריות שלו דרך Microsoft Graph"

#. what a command says
#: crates/engine/src/sync_driver/rules.rs
msgid "This account may not change its rules on the server"
msgstr "חשבון זה אינו מורשה לשנות את הכללים שלו בשרת"

#. what a command says
#: crates/engine/src/sync_driver/tasks.rs
msgid "This account may not use its to-dos through Microsoft Graph"
msgstr "חשבון זה אינו מורשה להשתמש במשימות שלו דרך Microsoft Graph"

#. what a command says
#: crates/engine/src/cmd/remote.rs
msgid "This account may only read the shared mailbox's calendar \"{name}\": the mailbox's owner hasn't given it edit rights (or they haven't been read yet)."
msgstr "חשבון זה רשאי רק לקרוא את לוח השנה \"{name}\" של תיבת הדואר המשותפת: בעל תיבת הדואר לא נתן לו הרשאות עריכה (או שהן עדיין לא נקראו)."

#. interface
#: crates/ui-egui/src/account_setup.rs
msgid "This account no longer uses an app password"
msgstr "חשבון זה אינו משתמש עוד בסיסמה לאפליקציה"

#. interface
#: crates/ui-egui/src/account_setup.rs
msgid "This account was added by a newer version of MailCraft. This version keeps it as it is and doesn't send or receive with it: use the newer version for that, and to change its settings."
msgstr "חשבון זה נוסף על ידי גרסה חדשה יותר של MailCraft. גרסה זו שומרת אותו כפי שהוא ואינה שולחת או מקבלת באמצעותו: השתמש בגרסה החדשה יותר לשם כך, וכדי לשנות את הגדרותיו."

#. interface
#: crates/ui-egui/src/account_setup.rs
msgid "This account was removed before Google sign-in began"
msgstr "חשבון זה הוסר לפני שהכניסה באמצעות Google החלה"

#. interface
#: crates/ui-egui/src/account_setup.rs
msgid "This account was removed while Google sign-in was open"
msgstr "חשבון זה הוסר בזמן שהכניסה באמצעות Google הייתה פתוחה"

#. what a command says
#: crates/engine/src/cmd/folder.rs
msgid "This account's Favorites come from Outlook and are changed there (File › Options can show the ones kept in MailCraft instead)"
msgstr "המועדפים של חשבון זה מגיעים מ־Outlook ומשתנים שם (תחת קובץ › אפשרויות ניתן להציג במקום זאת את אלה השמורים ב־MailCraft)"

#. interface
#: crates/ui-egui/src/calendar_sync.rs
msgid "This account's calendar can't be asked yet: Send/Receive signs it in first."
msgstr "עדיין לא ניתן לתשאל את לוח השנה של חשבון זה: שלח/קבל מחבר אותו תחילה."

#. interface
#: crates/ui-egui/src/people_view.rs
msgid "This account's server keeps this contact. Changes made here aren't sent back yet, so it can't be edited or deleted here. Favorite and categories are kept on this computer."
msgstr "שרת החשבון שומר איש קשר זה. שינויים הנעשים כאן אינם נשלחים בחזרה עדיין, ולכן לא ניתן לערוך או למחוק אותו כאן. המועדף והקטגוריות נשמרים במחשב זה."

#. interface
#: crates/ui-egui/src/attachment_preview.rs
msgid "This attachment could not be previewed."
msgstr "לא ניתן להציג תצוגה מקדימה של הקובץ המצורף."

#. interface
#: crates/ui-egui/src/attachment_preview.rs
msgid "This attachment is too large to preview."
msgstr "הקובץ המצורף גדול מדי לתצוגה מקדימה."

#. what a command says
#: crates/engine/src/sync_driver/free_busy.rs
msgid "This build can't ask a server when other people are busy: only your own calendar is shown."
msgstr "גרסה זו אינה יכולה לשאול שרת מתי אנשים אחרים עסוקים: מוצג רק לוח השנה שלך."

#. interface
#: crates/ui-egui/src/lib.rs crates/ui-egui/src/sending.rs crates/ui-egui/src/shared_mailboxes.rs
msgid "This build can't connect to Microsoft"
msgstr "גרסה זו אינה יכולה להתחבר אל Microsoft"

#. interface
#: crates/ui-egui/src/ews_mail.rs crates/ui-egui/src/jmap_mail.rs crates/ui-egui/src/lib.rs crates/ui-egui/src/sending.rs
msgid "This build can't connect to mail servers"
msgstr "גרסה זו אינה יכולה להתחבר לשרתי דואר"

#. interface
#: crates/ui-egui/src/lib.rs
msgid "This build can't connect to mail servers (a browser can't open mail connections). Use the desktop app, or bring mail in with File › Import."
msgstr "גרסה זו אינה יכולה להתחבר לשרתי דואר (דפדפן אינו יכול לפתוח חיבורי דואר). השתמש ביישום למחשב, או ייבא דואר באמצעות קובץ › ייבוא."

#. interface
#: crates/ui-egui/src/account_setup.rs
msgid "This build can't connect to mail servers, so the settings were kept without being tried. Bring mail in with File › Import, or use the desktop app."
msgstr "גרסה זו אינה יכולה להתחבר לשרתי דואר, ולכן ההגדרות נשמרו מבלי להיבדק. ייבא דואר באמצעות קובץ › ייבוא, או השתמש ביישום למחשב."

#. interface
#: crates/ui-egui/src/account_setup.rs
msgid "This build can't connect to mail servers. The account can still be added."
msgstr "גרסה זו אינה יכולה להתחבר לשרתי דואר. עדיין ניתן להוסיף את החשבון."

#. interface
#: crates/ui-egui/src/account_setup/exchange.rs
msgid "This build can't connect to mail servers. Use the desktop app to add an Exchange server account."
msgstr "גרסה זו אינה יכולה להתחבר לשרתי דואר. השתמש ביישום למחשב כדי להוסיף חשבון שרת Exchange."

#. interface
#: crates/ui-egui/src/ribbon.rs
msgid "This build can't connect to mail servers. Use the desktop app, or bring mail in with File › Import."
msgstr "גרסה זו אינה יכולה להתחבר לשרתי דואר. השתמש ביישום למחשב, או ייבא דואר באמצעות קובץ › ייבוא."

#. interface
#: crates/ui-egui/src/reading/remote.rs
msgid "This build can't download pictures"
msgstr "גרסה זו אינה יכולה להוריד תמונות"

#. interface
#: crates/ui-egui/src/reading/remote.rs
msgid "This build can't download pictures: they stay placeholders."
msgstr "גרסה זו אינה יכולה להוריד תמונות: הן נשארות כמצייני מיקום."

#. interface
#: crates/ui-egui/src/account_setup/exchange.rs
msgid "This build can't look anything up. Type the server's address in Server settings."
msgstr "גרסה זו אינה יכולה לאתר דבר. הקלד את כתובת השרת בהגדרות שרת."

#. interface
#: crates/ui-egui/src/favorites_sync.rs
msgid "This build can't make a link for an administrator."
msgstr "גרסה זו אינה יכולה ליצור קישור עבור מנהל מערכת."

#. interface
#: crates/ui-egui/src/approval.rs
msgid "This build can't open Microsoft's approval page. Copy the message for an administrator instead."
msgstr "גרסה זו אינה יכולה לפתוח את דף האישור של Microsoft. העתק במקום זאת את ההודעה למנהל המערכת."

#. interface
#: crates/ui-egui/src/calendar_sync.rs
msgid "This build can't reach the account's calendar."
msgstr "גרסה זו אינה יכולה להגיע ללוח השנה של החשבון."

#. interface
#: crates/ui-egui/src/favorites_sync.rs
msgid "This build can't reach the account's server."
msgstr "גרסה זו אינה יכולה להגיע לשרת של החשבון."

#. interface
#: crates/ui-egui/src/auto_replies.rs
msgid "This build can't reach the server to change automatic replies. Use the desktop app."
msgstr "גרסה זו אינה יכולה להתחבר לשרת כדי לשנות תשובות אוטומטיות. יש להשתמש ביישום למחשב."

#. interface
#: crates/ui-egui/src/lib.rs
msgid "This build can't sign in to this kind of account. Use the desktop app."
msgstr "גרסה זו אינה יכולה להתחבר לסוג חשבון זה. השתמש ביישום למחשב."

#. interface
#: crates/ui-egui/src/reading/unsubscribe.rs
msgid "This build can't unsubscribe in one click."
msgstr "גרסה זו אינה יכולה לבטל מנוי בלחיצה אחת."

#. interface
#: crates/ui-egui/src/updates.rs
msgid "This build doesn't check for new versions."
msgstr "גרסה זו אינה בודקת אם קיימות גרסאות חדשות."

#. interface
#: crates/ui-egui/src/calendar_view.rs
msgid "This calendar can only be read: new items can't go to it"
msgstr "לוח שנה זה לקריאה בלבד; אי אפשר להוסיף אליו פריטים חדשים"

#. what a command says
#: crates/engine/src/cmd/calendar.rs
msgid "This calendar is a copy of one on the web. Unsubscribe from it to remove it."
msgstr "לוח שנה זה הוא עותק של לוח שנה באינטרנט. בטל את המנוי אליו כדי להסיר אותו."

#. interface
#: crates/ui-egui/src/calendar_view.rs
msgid "This calendar isn't connected to your account yet. What changes elsewhere doesn't show here, and what you change here stays on this computer."
msgstr "לוח שנה זה עדיין אינו מחובר לחשבון שלך. שינויים המתרחשים במקום אחר אינם מוצגים כאן, ומה שאתה משנה כאן נשאר במחשב זה."

#. what a command says
#: crates/engine/src/cmd/category.rs
msgid "This category is on more events of calendars kept on a server than can wait to be sent at once: nothing was changed."
msgstr "קטגוריה זו נמצאת על יותר אירועים בלוחות שנה השמורים בשרת מכפי שניתן להמתין לשליחה בבת אחת: דבר לא שונה."

#. what a command says
#: crates/engine/src/private_keys.rs
msgid "This certificate's key is of a kind MailCraft doesn't use: only ECDSA on P-256 or P-384 is imported here."
msgstr "המפתח של אישור דיגיטלי זה הוא מסוג ש־MailCraft אינו משתמש בו: ניתן לייבא לכאן רק ECDSA על P-256 או P-384."

#. interface
#: crates/ui-egui/src/account_setup/exchange.rs
msgid "This computer doesn't trust the certificate the server at {host} shows. If this is your organisation's server, you can trust this one certificate for this account."
msgstr "מחשב זה אינו נותן אמון בתעודת האבטחה שמציג השרת בכתובת {host}. אם זהו שרת הארגון שלך, תוכל לתת אמון בתעודה אחת זו עבור חשבון זה."

#. interface
#: crates/ui-egui/src/reading/signature.rs
msgid "This computer's certification authorities haven't been read yet: the signature is checked again when they are."
msgstr "רשויות האישורים של מחשב זה עדיין לא נקראו: החתימה תיבדק שוב כשייקראו."

#. interface
#: crates/ui-egui/src/zones.rs
msgid "This computer's time"
msgstr "השעה של מחשב זה"

#. interface
#: crates/ui-egui/src/backstage.rs
msgid "This computer's, wherever it goes"
msgstr "של מחשב זה, בכל מקום שבו הוא נמצא"

#. interface
#: crates/ui-egui/src/dialogs.rs
msgid "This contact will be permanently deleted."
msgstr "איש קשר זה יימחק לצמיתות."

#. interface
#: crates/ui-egui/src/updates.rs
msgid "This copy of MailCraft doesn't update itself."
msgstr "עותק זה של MailCraft אינו מעדכן את עצמו."

#. interface
#: crates/ui-egui/src/dialogs.rs
msgid "This deletes the conversation from {folder}: its {n} message there goes to Deleted Items."
msgid_plural "This deletes the conversation from {folder}: its {n} messages there go to Deleted Items."
msgstr[0] "פעולה זו מוחקת את השיחה מתוך {folder}: הודעה {n} שלה שם עוברת אל \"פריטים שנמחקו\"."
msgstr[1] "פעולה זו מוחקת את השיחה מתוך {folder}: {n} ההודעות שלה שם עוברות אל \"פריטים שנמחקו\"."

#. interface
#: crates/ui-egui/src/dialogs.rs
msgid "This deletes the {n} message of this conversation that is listed here. It goes to Deleted Items."
msgid_plural "This deletes the {n} messages of this conversation that are listed here. They go to Deleted Items."
msgstr[0] "פעולה זו מוחקת הודעה {n} של שיחה זו המופיעה כאן. היא עוברת אל \"פריטים שנמחקו\"."
msgstr[1] "פעולה זו מוחקת את {n} ההודעות של שיחה זו המופיעות כאן. הן עוברות אל \"פריטים שנמחקו\"."

#. interface
#: crates/ui-egui/src/dialogs.rs
msgid "This deletes {n} message in {folder}, every message of the conversation there included. It goes to Deleted Items."
msgid_plural "This deletes {n} messages in {folder}, every message of the conversation there included. They go to Deleted Items."
msgstr[0] "פעולה זו מוחקת הודעה {n} בתיקייה {folder}, כולל כל הודעות השיחה שם. היא עוברת אל \"פריטים שנמחקו\"."
msgstr[1] "פעולה זו מוחקת {n} הודעות בתיקייה {folder}, כולל כל הודעות השיחה שם. הן עוברות אל \"פריטים שנמחקו\"."

#. interface
#: crates/ui-egui/src/dialogs.rs
msgid "This deletes {n} message in {folder}, every message of the conversations there included. It goes to Deleted Items."
msgid_plural "This deletes {n} messages in {folder}, every message of the conversations there included. They go to Deleted Items."
msgstr[0] "פעולה זו מוחקת הודעה {n} בתיקייה {folder}, כולל כל הודעות השיחות שם. היא עוברת אל \"פריטים שנמחקו\"."
msgstr[1] "פעולה זו מוחקת {n} הודעות בתיקייה {folder}, כולל כל הודעות השיחות שם. הן עוברות אל \"פריטים שנמחקו\"."

#. interface
#: crates/ui-egui/src/dialogs.rs
msgid "This deletes {n} message, including the conversation's messages listed here. It goes to Deleted Items."
msgid_plural "This deletes {n} messages, including the conversation's messages listed here. They go to Deleted Items."
msgstr[0] "פעולה זו מוחקת הודעה {n}, כולל הודעות השיחה המופיעות כאן. היא עוברת אל \"פריטים שנמחקו\"."
msgstr[1] "פעולה זו מוחקת {n} הודעות, כולל הודעות השיחה המופיעות כאן. הן עוברות אל \"פריטים שנמחקו\"."

#. interface
#: crates/ui-egui/src/dialogs.rs
msgid "This deletes {n} message, including the conversations' messages listed here. It goes to Deleted Items."
msgid_plural "This deletes {n} messages, including the conversations' messages listed here. They go to Deleted Items."
msgstr[0] "פעולה זו מוחקת הודעה {n}, כולל הודעות השיחות המופיעות כאן. היא מועברת אל ״פריטים שנמחקו״."
msgstr[1] "פעולה זו מוחקת {n} הודעות, כולל הודעות השיחות המופיעות כאן. הן מועברות אל ״פריטים שנמחקו״."

#. name
#: crates/ui-egui/src/account_setup.rs
msgid "This device only"
msgstr "מכשיר זה בלבד"

#. interface
#: crates/ui-egui/src/account_setup/exchange.rs
msgid "This domain's servers have no automatic setup. Type the server's address in Server settings."
msgstr "לשרתים של דומיין זה אין הגדרה אוטומטית. הקלד את כתובת השרת ב״הגדרות שרת״."

#. what a command says
#: crates/engine/src/cmd/calendar/meeting.rs
msgid "This event is kept by the server of {who}. It can be moved to another calendar of that account, not out of it: taking it out would delete it there."
msgstr "אירוע זה שמור בשרת של {who}. אפשר להעביר אותו ללוח שנה אחר באותו חשבון, אך לא מחוץ לו: הוצאתו מהחשבון תמחק אותו שם."

#. interface
#: crates/ui-egui/src/import_pst.rs
msgid "This file can't be imported: {why}"
msgstr "לא ניתן לייבא את הקובץ: {why}"

#. interface
#: crates/ui-egui/src/import_pst.rs
msgid "This file has a password. Nothing is imported without it."
msgstr "הקובץ מוגן בסיסמה. לא ניתן לייבא ממנו דבר בלי הסיסמה."

#. android
#: apps/mailcraft-android/app/src/main/kotlin/work/mailcraft/android/MailListBar.kt
msgid "This folder"
msgstr "תיקייה זו"

#. interface
#: crates/ui-egui/src/meeting_dialogs.rs
msgid "This invitation can't be answered from here, so no other time can be proposed for it."
msgstr "אי אפשר להשיב להזמנה זו מכאן, ולכן אי אפשר להציע עבורה מועד אחר."

#. interface
#: crates/ui-egui/src/reading/invitation.rs
msgid "This invitation doesn't say when the meeting is."
msgstr "הזמנה זו אינה מציינת מתי הפגישה מתקיימת."

#. interface, what a command says
#: crates/engine/src/cmd/calendar/invitation.rs crates/ui-egui/src/reading/invitation.rs
msgid "This invitation doesn't say which meeting it is about, so it can't be answered."
msgstr "הזמנה זו אינה מציינת באיזו פגישה מדובר, ולכן אי אפשר להשיב לה."

#. what a command says
#: crates/engine/src/cmd/calendar/invitation.rs
msgid "This invitation has the ID of a meeting on your calendar but isn't from its organizer, so it can't change that meeting. To answer, open the meeting on your calendar and answer there."
msgstr "להזמנה זו יש מזהה של פגישה בלוח השנה שלך, אך היא אינה מהמארגן שלה, ולכן אינה יכולה לשנות את הפגישה הזו. כדי להשיב, פתח את הפגישה בלוח השנה שלך והשב שם."

#. what a command says
#: crates/engine/src/cmd/calendar/invitation.rs
msgid "This invitation has the ID of a meeting on your calendar but names another organizer, so it can't change that meeting."
msgstr "להזמנה זו יש מזהה של פגישה בלוח השנה שלך, אך היא מציינת מארגן אחר, ולכן אינה יכולה לשנות את הפגישה הזו."

#. interface
#: crates/ui-egui/src/updates.rs
msgid "This is a development build: it checks only when you press Check for Updates."
msgstr "זו גרסת פיתוח: היא בודקת עדכונים רק בלחיצה על ״בדוק אם קיימים עדכונים״."

#. interface
#: crates/ui-egui/src/reading/invitation.rs
msgid "This is about one occurrence of a series."
msgstr "מדובר במופע אחד מתוך סדרה."

#. interface
#: crates/ui-egui/src/meeting_dialogs.rs
msgid "This is about the occurrence on {day} only."
msgstr "מדובר במופע בתאריך {day} בלבד."

#. what a command says
#: crates/engine/src/private_keys.rs
msgid "This is an RSA certificate, which MailCraft doesn't use by itself on this system: put it on a smartcard or token (PKCS#11), where MailCraft finds it."
msgstr "זהו אישור RSA ש־MailCraft אינו משתמש בו בעצמו במערכת זו: העבר אותו לכרטיס חכם או לטוקן (PKCS#11), שם MailCraft מוצא אותו."

#. what a command says
#: crates/engine/src/private_keys.rs
msgid "This is an RSA key, which MailCraft doesn't use by itself: keep it in GnuPG, whose agent MailCraft signs with, and leave it out of here."
msgstr "זהו מפתח RSA ש־MailCraft אינו משתמש בו בעצמו: שמור אותו ב־GnuPG, שבאמצעות הסוכן שלו MailCraft חותם, ואל תוסיף אותו לכאן."

#. what a command says
#: crates/engine/src/cmd/calendar/invitation.rs
msgid "This is not somebody else's meeting: a message can't call it off."
msgstr "זו אינה פגישה של מישהו אחר: הודעה אינה יכולה לבטל אותה."

#. what a command says
#: crates/engine/src/cmd/calendar/meeting.rs
msgid "This isn't an online meeting."
msgstr "זו אינה פגישה מקוונת."

#. interface
#: crates/ui-egui/src/account_setup.rs
msgid "This isn't the account you typed"
msgstr "זה אינו החשבון שהקלדת"

#. interface
#: crates/ui-egui/src/dialogs.rs
msgid "This item has changes that aren't saved. Save them?"
msgstr "בפריט זה יש שינויים שלא נשמרו. לשמור אותם?"

#. what a command says
#: crates/engine/src/cmd/calendar_extra.rs
msgid "This item has files attached, which only the server keeps and which a copy would be without: it can't be copied from here."
msgstr "לפריט זה מצורפים קבצים שנשמרים בשרת בלבד והיו חסרים בעותק: אי אפשר להעתיק אותו מכאן."

#. what a command says
#: crates/engine/src/cmd/calendar/meeting.rs
msgid "This item has files attached, which only the server keeps and which would be lost: it can't be moved to another calendar from here."
msgstr "לפריט זה מצורפים קבצים שנשמרים בשרת בלבד והיו אובדים: אי אפשר להעביר אותו מכאן ללוח שנה אחר."

#. what a command says
#: crates/engine/src/cmd/calendar/meeting.rs
msgid "This item hasn't reached the server of {who} yet. Forward it once it is there (in a moment)."
msgstr "פריט זה עדיין לא הגיע לשרת של {who}. העבר אותו לאחר שיגיע לשם (בעוד רגע)."

#. what a command says
#: crates/engine/src/cmd/calendar/meeting.rs
msgid "This item is still on its way to the account's server. Move it once it is there (in a moment)."
msgstr "פריט זה עדיין בדרכו לשרת של החשבון. העבר אותו לאחר שיגיע לשם (בעוד רגע)."

#. what a command says
#: crates/engine/src/private_keys.rs
msgid "This key can't make Digital signatures: none of its keys may sign, or its secret parts aren't in the file."
msgstr "מפתח זה אינו יכול ליצור חתימות דיגיטליות: אף אחד ממפתחותיו אינו מורשה לחתום, או שחלקיו הסודיים אינם נמצאים בקובץ."

#. what a command says
#: crates/engine/src/private_keys.rs
msgid "This key has no passphrase, so MailCraft doesn't keep it. Add one in GnuPG (gpg --edit-key <key>, then passwd) and import it again."
msgstr "למפתח זה אין ביטוי סיסמה, ולכן MailCraft אינו שומר אותו. הוסף ביטוי סיסמה ב־GnuPG (gpg --edit-key <key>, ולאחר מכן passwd) וייבא אותו שוב."

#. what a command says
#: crates/engine/src/private_keys.rs
msgid "This key signs with an algorithm MailCraft doesn't use: only Ed25519 and ECDSA keys are imported here."
msgstr "מפתח זה חותם באמצעות אלגוריתם ש־MailCraft אינו משתמש בו: כאן מיובאים רק מפתחות Ed25519 ו־ECDSA."

#. what a command says
#: crates/mobile/src/sync.rs
msgid "This kind of account can't be sent and received on the phone yet."
msgstr "סוג חשבון זה עדיין אינו יכול לשלוח ולקבל דואר בטלפון."

#. interface
#: crates/ui-egui/src/reading/view.rs
msgid "This link goes somewhere other than its text says."
msgstr "קישור זה מוביל למקום אחר מזה שהטקסט שלו מציין."

#. android
#: apps/mailcraft-android/app/src/main/kotlin/work/mailcraft/android/ReadingScreen.kt
msgid "This link goes to"
msgstr "קישור זה מוביל אל"

#. interface
#: crates/ui-egui/src/reading/unsubscribe.rs
msgid "This list unsubscribes on its own page, at {host}. It opens in your browser: visiting it tells the list that this address is read."
msgstr "ביטול ההרשמה מרשימה זו מתבצע בדף שלה, בכתובת {host}. הדף ייפתח בדפדפן שלך: ביקור בו מודיע לרשימה שכתובת זו נקראת."

#. interface
#: crates/ui-egui/src/reading/unsubscribe.rs
msgid "This list's page isn't one that can be opened."
msgstr "אי אפשר לפתוח את הדף של רשימה זו."

#. interface
#: crates/ui-egui/src/account_setup/exchange.rs
msgid "This mailbox is in Microsoft 365"
msgstr "תיבת דואר זו נמצאת ב־Microsoft 365"

#. interface
#: crates/ui-egui/src/chrome.rs
msgid "This mailbox is on this device only"
msgstr "תיבת דואר זו נמצאת במכשיר הזה בלבד"

#. interface
#: crates/ui-egui/src/unconfirmed.rs
msgid "This mailbox was opened from a file. Its accounts connect to:"
msgstr "תיבת דואר זו נפתחה מקובץ. החשבונות שבה מתחברים אל:"

#. interface
#: crates/ui-egui/src/lib.rs
msgid "This mailbox was opened from a file: confirm its servers first"
msgstr "תיבת דואר זו נפתחה מקובץ: אשר תחילה את השרתים שלה"

#. interface
#: crates/ui-egui/src/calendar_sync.rs
msgid "This makes, changes and deletes a test appointment in the account's real calendar. Say that this is meant with \"confirmed\": true."
msgstr "פעולה זו יוצרת, משנה ומוחקת פעילות בדיקה בלוח השנה האמיתי של החשבון. ציין שזו הכוונה באמצעות \"confirmed\": true."

#. interface
#: crates/ui-egui/src/reading/invitation.rs
msgid "This meeting"
msgstr "פגישה זו"

#. what a command says
#: crates/engine/src/cmd/calendar.rs
msgid "This meeting hasn't reached the server of {who} yet."
msgstr "פגישה זו עדיין לא הגיעה לשרת של {who}."

#. interface
#: crates/ui-egui/src/reading/invitation.rs
msgid "This meeting is in a calendar that can't be changed from here."
msgstr "פגישה זו נמצאת בלוח שנה שאי אפשר לשנות מכאן."

#. what a command says
#: crates/engine/src/cmd/calendar/meeting.rs
msgid "This meeting is kept by the server of {who}, and somebody else organizes it. Whether it is held online is for its organizer to say."
msgstr "פגישה זו שמורה בשרת של {who}, ומישהו אחר מארגן אותה. המארגן הוא שקובע אם היא תתקיים באופן מקוון."

#. what a command says
#: crates/engine/src/cmd/calendar.rs
msgid "This meeting is kept by the server of {who}, and somebody else organizes it. {why}"
msgstr "פגישה זו שמורה בשרת של {who}, ומישהו אחר מארגן אותה. {why}"

#. interface
#: crates/ui-egui/src/reading/invitation.rs
msgid "This meeting is over."
msgstr "פגישה זו הסתיימה."

#. what a command says
#: crates/engine/src/cmd/calendar/invitation.rs
msgid "This meeting isn't on the account's calendar here yet: its server puts it there, and it hasn't come down. Answer it from the calendar once it shows."
msgstr "פגישה זו עדיין אינה מופיעה כאן בלוח השנה של החשבון: השרת שלה מוסיף אותה לשם, והיא טרם התקבלה. השב לה מתוך לוח השנה לאחר שתופיע."

#. interface
#: crates/ui-egui/src/reading/invitation.rs
msgid "This meeting isn't on your calendar here yet. It can be answered as soon as it shows there."
msgstr "פגישה זו עדיין אינה מופיעה כאן בלוח השנה שלך. אפשר יהיה להשיב לה ברגע שתופיע שם."

#. interface
#: crates/ui-egui/src/reading/invitation.rs
msgid "This meeting was called off by its organizer."
msgstr "פגישה זו בוטלה על ידי המארגן שלה."

#. what a command says
#: crates/engine/src/sync_driver/free_busy.rs
msgid "This meeting's calendar is kept on this computer, which can't tell when other people are busy: only your own calendar is shown."
msgstr "לוח השנה של פגישה זו שמור במחשב זה, שאינו יכול לדעת מתי אנשים אחרים עסוקים: רק לוח השנה שלך מוצג."

#. interface
#: crates/ui-egui/src/meeting_dialogs.rs
msgid "This meeting's link isn't one that can be opened."
msgstr "אי אפשר לפתוח את הקישור של פגישה זו."

#. interface
#: crates/ui-egui/src/reading/warnings.rs
msgid "This message came from outside your organisation."
msgstr "הודעה זו הגיעה מחוץ לארגון שלך."

#. interface, what a command says
#: crates/engine/src/cmd/calendar/invitation.rs crates/ui-egui/src/reading/invitation.rs
msgid "This message carries no invitation."
msgstr "הודעה זו אינה כוללת הזמנה."

#. interface
#: crates/ui-egui/src/reading/invitation.rs
msgid "This message didn't come from the address of the meeting's organizer."
msgstr "הודעה זו לא הגיעה מכתובתו של מארגן הפגישה."

#. what a command says
#: crates/engine/src/cmd/calendar/invitation.rs
msgid "This message doesn't call a meeting off."
msgstr "הודעה זו אינה מבטלת פגישה."

#. what a command says
#: crates/engine/src/cmd/calendar/meeting.rs
msgid "This message doesn't propose another time for a meeting."
msgstr "הודעה זו אינה מציעה מועד אחר לפגישה."

#. interface, what a command says
#: crates/engine/src/cmd/unsubscribe.rs crates/ui-egui/src/reading/unsubscribe.rs
msgid "This message doesn't say how to unsubscribe from it."
msgstr "הודעה זו אינה מציינת כיצד לבטל את ההרשמה ממנה."

#. interface
#: crates/ui-egui/src/reading.rs
msgid "This message downloads once the messages being downloaded now are here."
msgstr "הודעה זו תרד לאחר שההודעות שיורדות כעת יתקבלו."

#. what a command says
#: crates/engine/src/cmd/unsubscribe.rs
msgid "This message has a warning about its sender: move it to Junk E-mail instead of unsubscribing."
msgstr "להודעה זו יש אזהרה לגבי השולח שלה: העבר אותה אל ״דואר זבל״ במקום לבטל את ההרשמה."

#. interface
#: crates/ui-egui/src/send_warnings.rs
msgid "This message has more recipients than MailCraft checks: only the first one was looked at."
msgid_plural "This message has more recipients than MailCraft checks: only the first {n} were looked at."
msgstr[0] "להודעה זו יש יותר נמענים ממה ש־MailCraft בודק: רק הנמען הראשון נבדק."
msgstr[1] "להודעה זו יש יותר נמענים ממה ש־MailCraft בודק: רק {n} הנמענים הראשונים נבדקו."

#. interface
#: crates/ui-egui/src/reading/view.rs
msgid "This message has no text."
msgstr "להודעה זו אין טקסט."

#. interface
#: crates/ui-egui/src/reading/remote.rs
msgid "This message has pictures on the web. This build can't download them."
msgstr "הודעה זו כוללת תמונות מהאינטרנט. גרסה זו אינה יכולה להוריד אותן."

#. interface
#: crates/ui-egui/src/reading.rs
msgid "This message hasn't been sent."
msgstr "הודעה זו לא נשלחה."

#. interface
#: crates/ui-egui/src/send_later.rs
msgid "This message is delayed. It goes {when}."
msgstr "הודעה זו מושהית. היא תישלח {when}."

#. interface
#: crates/ui-egui/src/send_later.rs
msgid "This message is due and goes with the next Send/Receive."
msgstr "מועד שליחתה של הודעה זו הגיע, והיא תישלח בפעולת שלח/קבל הבאה."

#. what a command says
#: crates/engine/src/cmd/unsubscribe.rs
msgid "This message is in Junk E-mail: delete it rather than unsubscribing."
msgstr "הודעה זו נמצאת בתיקיית ״דואר זבל״: מחק אותה במקום לבטל את ההרשמה."

#. what a command says
#: crates/engine/src/cmd/calendar/invitation.rs
msgid "This message isn't an invitation that can be answered."
msgstr "הודעה זו אינה הזמנה שאפשר להשיב לה."

#. what a command says
#: crates/engine/src/cmd/calendar/invitation.rs
msgid "This message isn't from the organizer of that meeting, so it can't call it off: take the meeting out of the calendar yourself."
msgstr "הודעה זו אינה ממארגן הפגישה הזאת, ולכן אינה יכולה לבטל אותה: הסר את הפגישה מלוח השנה בעצמך."

#. interface
#: crates/ui-egui/src/graph_fetch.rs crates/ui-egui/src/reading.rs
msgid "This message isn't on this computer yet. It will download when you're online."
msgstr "הודעה זו עדיין אינה נמצאת במחשב זה. היא תרד כשתהיה במצב מקוון."

#. interface
#: crates/ui-egui/src/reading/warnings.rs
msgid "This message lays itself out in more ways than MailCraft could check, so a link in one of them may go somewhere other than its text says."
msgstr "בהודעה זו יש תצוגות נוספות שלא ניתן היה לבדוק ב־MailCraft. קישור באחת מהן עלול להוביל לכתובת אחרת מזו שמוצגת בטקסט."

#. interface
#: crates/ui-egui/src/reading/warnings.rs
msgid "This message may not be what it seems."
msgstr "ייתכן שהודעה זו אינה כפי שהיא נראית."

#. interface
#: crates/ui-egui/src/reading/signature.rs
msgid "This message was changed after it was signed."
msgstr "הודעה זו שונתה לאחר שנחתמה."

#. interface
#: crates/ui-egui/src/reading.rs
msgid "This message was sent with High importance."
msgstr "הודעה זו נשלחה בחשיבות גבוהה."

#. interface
#: crates/ui-egui/src/reading.rs
msgid "This message was sent with Low importance."
msgstr "הודעה זו נשלחה בחשיבות נמוכה."

#. interface
#: crates/ui-egui/src/dialogs.rs
msgid "This message will be permanently deleted."
msgstr "הודעה זו תימחק לצמיתות."

#. interface
#: crates/ui-egui/src/reading/signature.rs
msgid "This message's Digital signature can't be checked."
msgstr "לא ניתן לאמת את החתימה הדיגיטלית של הודעה זו."

#. android
#: apps/mailcraft-android/app/src/main/kotlin/work/mailcraft/android/People.kt
msgid "This person could not be read."
