#. why a mail server couldn't be used
#: crates/proto/src/smtp.rs
msgid "\"{address}\" can't be used as an address"
msgstr "לא ניתן להשתמש ב-\"{address}\" ככתובת"

#. why a mail server couldn't be used
#: crates/net/src/send.rs
msgid "\"{address}\" isn't an address mail can be sent to"
msgstr "\"{address}\" אינה כתובת שניתן לשלוח אליה דואר"

#. interface, what a command says
#: crates/engine/src/cmd/calendar.rs crates/engine/src/cmd/compose.rs crates/engine/src/cmd/senders.rs crates/ui-egui/src/account_setup.rs crates/ui-egui/src/account_setup/senders.rs
msgid "\"{address}\" isn't an e-mail address"
msgstr "\"{address}\" אינה כתובת דוא\"ל"

#. what a command says
#: crates/engine/src/cmd/compose.rs
msgid "\"{address}\" on the {what} line isn't an e-mail address"
msgstr "\"{address}\" בשורת {what} אינה כתובת דוא\"ל"

#. why a mail server couldn't be used
#: crates/proto/src/imap/mod.rs
msgid "\"{date}\" is not a date and time IMAP can carry"
msgstr "\"{date}\" אינו תאריך ושעה ש-IMAP יכול להעביר"

#. why a mail server couldn't be used
#: crates/proto/src/imap/mod.rs
msgid "\"{field}\" is not the name of a header field"
msgstr "\"{field}\" אינו שם של שדה כותרת"

#. why a mail server couldn't be used
#: crates/proto/src/imap/mod.rs
msgid "\"{flag}\" can't be used as a flag"
msgstr "לא ניתן להשתמש ב-\"{flag}\" כדגל"

#. why a mail server couldn't be used
#: crates/proto/src/imap/mod.rs
msgid "\"{line}\" is not an IMAP response"
msgstr "\"{line}\" אינה תגובת IMAP"

#. why a mail server couldn't be used
#: crates/proto/src/smtp.rs
msgid "\"{line}\" is not an SMTP reply"
msgstr "\"{line}\" אינה תשובת SMTP"

#. interface
#: crates/ui-egui/src/dialogs.rs
msgid "\"{name}\" has changes that aren't saved. Save them?"
msgstr "יש שינויים שלא נשמרו ב־\"{name}\". לשמור אותם?"

#. what a command says
#: crates/engine/src/cmd/people_merge.rs
msgid "\"{name}\" is kept by the server of {who}. Changes made here are not sent back yet, so it can't be merged here."
msgstr "\"{name}\" נשמר בשרת של {who}. שינויים שנעשו כאן עדיין אינם נשלחים בחזרה, ולכן לא ניתן למזג אותו כאן."

#. interface
#: crates/ui-egui/src/check_names.rs
msgid "\"{name}\" is no longer on the recipient lines"
msgstr "\"{name}\" אינו מופיע עוד בשורות הנמענים"

#. interface
#: crates/ui-egui/src/dialogs.rs
msgid "\"{name}\" is one of a series. Do you mean just the one on {day}, or the entire series?"
msgstr "הפריט \"{name}\" הוא חלק מסדרה. האם הכוונה לפריט בתאריך {day} בלבד או לסדרה כולה?"

#. what a command says
#: crates/engine/src/cmd/category.rs
msgid "\"{name}\" isn't a category kept on this computer only"
msgstr "\"{name}\" אינה קטגוריה הנשמרת במחשב זה בלבד"

#. interface
#: crates/ui-egui/src/dialogs.rs
msgid "\"{name}\" will be permanently deleted."
msgstr "\"{name}\" יימחק לצמיתות."

#. why a mail server couldn't be used
#: crates/proto/src/imap/mod.rs
msgid "\"{set}\" doesn't name the messages to change"
msgstr "\"{set}\" אינו מציין את ההודעות שיש לשנות"

#. why a mail server couldn't be used
#: crates/proto/src/imap/mod.rs
msgid "\"{set}\" is not a set of messages"
msgstr "\"{set}\" אינה קבוצה של הודעות"

#. what a command says
#: crates/engine/src/cmd/calendar/meeting.rs
msgid "\"{shown}\" isn't an e-mail address"
msgstr "\"{shown}\" אינה כתובת דוא\"ל"

#. what a command says
#: crates/engine/src/cmd/graph_send.rs
msgid "'{subject}' may have been sent, even if its copy in Sent (or Drafts) is still marked as a draft. It is held in the Outbox."
msgstr "ייתכן שההודעה '{subject}' נשלחה, גם אם העותק שלה בתיקיית 'נשלחו' (או 'טיוטות') עדיין מסומן כטיוטה. היא מוחזקת בתיבת הדואר היוצא."

#. what a command says
#: crates/engine/src/cmd/graph_send.rs
msgid "'{subject}' may have been sent: look in Sent Items. It is held in the Outbox."
msgstr "ייתכן שההודעה '{subject}' נשלחה: בדקו ב'פריטים שנשלחו'. היא מוחזקת בתיבת הדואר היוצא."

#. what a command says
#: crates/engine/src/cmd/snooze.rs
msgid "'{subject}' stays in the Snoozed folder: the server would not move it back, so it is no longer snoozed."
msgstr "ההודעה '{subject}' נשארת בתיקיית 'מושהות': השרת לא העביר אותה בחזרה, לכן היא אינה מושהית עוד."

#. what a command says
#: crates/engine/src/undo.rs
msgid "'{subject}' stays where it was moved: it is Digitally signed or Encrypted, and its copy in the mailbox it came from was removed while the copy it was first moved out of keeps the bytes it came as. Move it back to put it there again."
msgstr "ההודעה '{subject}' נשארת במקום שאליו הועברה: היא חתומה דיגיטלית או מוצפנת, והעותק שלה בתיבת הדואר שממנה הגיעה הוסר, בעוד שהעותק שממנו הועברה לראשונה שומר על הבתים המקוריים שבהם הגיעה. העבירו אותה בחזרה כדי להחזיר אותה לשם."

