#: crates/ui-egui/src/backstage.rs
msgid "Mail to keep offline:"
msgstr "דואר לשמירה במצב לא מקוון:"

#. android
#: apps/mailcraft-android/app/src/main/kotlin/work/mailcraft/android/SettingsSummaries.kt
msgid "Mail, accounts and sign-ins on this phone"
msgstr "דואר, חשבונות ופרטי כניסה בטלפון זה"

#. interface
#: crates/ui-egui/src/dialogs.rs
msgid "Mail, calendar, people and tasks, written from scratch in Rust."
msgstr "דואר, לוח שנה, אנשי קשר ומשימות, שנכתבו מאפס ב־Rust."

#. interface
#: crates/ui-egui/src/backstage.rs
msgid "Mail, calendar, people and tasks, written from scratch in Rust. It runs natively on macOS, Windows, Linux and BSD, and in the browser."
msgstr "דואר, לוח שנה, אנשי קשר ומשימות, שנכתבו מאפס ב־Rust. היישום פועל באופן טבעי ב־macOS,‏ Windows,‏ Linux ו־BSD, וכן בדפדפן."

#. interface
#: crates/ui-egui/src/graph_switch.rs
msgid "MailCraft can now keep {account} in step with Microsoft through Microsoft Graph, the way Outlook on the web does, instead of IMAP. Your folders, flags, categories and drafts then match what you see in Outlook, and your mail keeps coming even where your organisation has turned IMAP off."
msgstr "כעת MailCraft יכול לסנכרן את {account} מול Microsoft באמצעות Microsoft Graph, בדומה ל־Outlook באינטרנט, במקום IMAP. התיקיות, הדגלים, הקטגוריות והטיוטות שלך יתאימו למה שמוצג ב־Outlook, והדואר שלך ימשיך להגיע גם אם הארגון שלך כיבה את IMAP."

#. name
#: crates/engine/src/cmd/rules.rs
msgid "MailCraft can't keep this account's rules on its server"
msgstr "MailCraft אינו יכול לשמור את כללי החשבון הזה בשרת שלו"

#. interface
#: crates/ui-egui/src/account_setup/exchange.rs
msgid "MailCraft can't sign in to this server this way yet (it wants Kerberos). Ask your administrator whether it can take a user name and password over an encrypted connection."
msgstr "MailCraft עדיין אינו יכול להיכנס לשרת זה בשיטה זו (הוא דורש Kerberos). בדוק מול מנהל המערכת אם השרת מקבל שם משתמש וסיסמה דרך חיבור מוצפן."

#. android
#: apps/mailcraft-android/app/src/main/kotlin/work/mailcraft/android/AboutPages.kt
msgid "MailCraft carries the software below. The Rust libraries of its core are listed with their versions in the source repository."
msgstr "MailCraft כולל את רכיבי התוכנה שלהלן. ספריות ה־Rust שבליבתו מפורטות עם גרסאותיהן במאגר קוד המקור."

#. android
#: apps/mailcraft-android/app/src/main/kotlin/work/mailcraft/android/Accounts.kt
msgid "MailCraft couldn't open a browser for Microsoft's page."
msgstr "MailCraft לא הצליח לפתוח דפדפן עבור הדף של Microsoft."

#. android
#: apps/mailcraft-android/app/src/main/kotlin/work/mailcraft/android/Accounts.kt
msgid "MailCraft couldn't open a browser for Microsoft's page. Install or enable a browser, then try again."
msgstr "MailCraft לא הצליח לפתוח דפדפן עבור הדף של Microsoft. התקן או הפעל דפדפן, ולאחר מכן נסה שוב."

#. interface
#: crates/ui-egui/src/approval.rs
msgid "MailCraft couldn't open your browser for Microsoft's approval page. Copy the message instead: the link in it opens the same page."
msgstr "MailCraft לא הצליח לפתוח את הדפדפן עבור דף האישור של Microsoft. העתק במקום זאת את ההודעה: הקישור שבה פותח את אותו הדף."

#. android
#: apps/mailcraft-android/app/src/main/kotlin/work/mailcraft/android/AccountScreens.kt
msgid "MailCraft couldn't save your latest changes yet. It will try again; if the app closes first they may be lost."
msgstr "MailCraft עדיין לא הצליח לשמור את השינויים האחרונים שלך. היישום ינסה שוב; אם ייסגר קודם לכן, השינויים עלולים ללכת לאיבוד."

#. android
#: apps/mailcraft-android/app/src/main/kotlin/work/mailcraft/android/AccountScreens.kt
msgid "MailCraft couldn't set aside the saved mailbox it couldn't read, so changes aren't saved this time. Free up space and restart the app."
msgstr "MailCraft לא הצליח להזיז הצידה את תיבת הדואר השמורה שלא ניתן היה לקרוא, ולכן השינויים אינם נשמרים הפעם. פנה שטח אחסון והפעל מחדש את היישום."

#. what a command says
#: crates/model/src/mailbox.rs
msgid "MailCraft doesn't delete a JMAP account's folders yet: the next Send/Receive would bring them back"
msgstr "MailCraft עדיין אינו מוחק תיקיות של חשבון JMAP: פעולת השליחה והקבלה הבאה תחזיר אותן"

#. interface
#: crates/ui-egui/src/account_setup.rs
msgid "MailCraft doesn't know the settings for this address. The servers below are only a guess made from its domain: check them with your provider or administrator before you connect."
msgstr "MailCraft אינו מכיר את ההגדרות עבור כתובת זו. השרתים שלהלן הם ניחוש בלבד לפי הדומיין שלה: בדוק אותם מול הספק או מנהל המערכת שלך לפני ההתחברות."

#. what a command says
#: crates/model/src/mailbox.rs
msgid "MailCraft doesn't rename or move a JMAP account's folders yet: its server wouldn't be told"
msgstr "MailCraft עדיין אינו משנה שמות של תיקיות או מעביר אותן בחשבון JMAP: השרת שלו לא יעודכן בכך"

#. interface
#: crates/ui-egui/src/account_setup.rs
msgid "MailCraft doesn't support POP yet. Use your provider's IMAP server instead (usually imap.<your domain>, port 993)."
msgstr "MailCraft עדיין אינו תומך ב־POP. השתמש במקום זאת בשרת ה־IMAP של הספק שלך (לרוב ‎imap.<הדומיין שלך>‎, יציאה 993)."

#. interface
#: crates/ui-egui/src/software.rs
msgid "MailCraft is drawing without the graphics card, which uses a lot of processor time. Installing or updating the graphics driver usually fixes this."
msgstr "MailCraft מבצע רינדור ללא כרטיס המסך, דבר הצורך זמן מעבד רב. התקנה או עדכון של מנהל ההתקן של כרטיס המסך פותרים זאת בדרך כלל."

#. interface
#: crates/ui-egui/src/ribbon.rs
msgid "MailCraft is open source (MIT or Apache-2.0). Every button here runs a command that scripts and agents can run too: see Search Commands."
msgstr "MailCraft הוא קוד פתוח (MIT או Apache-2.0). כל לחצן כאן מפעיל פקודה שגם סקריפטים וסוכנים יכולים להפעיל: ראה ״חיפוש פקודות״."

#. android
#: apps/mailcraft-android/app/src/main/kotlin/work/mailcraft/android/AboutPages.kt
msgid "MailCraft is open source, under the MIT and Apache 2.0 licences."
msgstr "MailCraft הוא קוד פתוח, תחת רישיונות MIT ו־Apache 2.0."

#. interface
#: crates/ui-egui/src/credits.rs
msgid "MailCraft is tested on real mail, by people who use it every day and tell us what goes wrong. Thank you."
msgstr "MailCraft נבדק על דואר אמיתי, בידי אנשים שמשתמשים בו מדי יום ומדווחים לנו מה משתבש. תודה."

#. interface
#: crates/ui-egui/src/updates.rs
msgid "MailCraft is up to date ({version})."
msgstr "MailCraft מעודכן ({version})."

#. interface
#: crates/ui-egui/src/open_shared.rs crates/ui-egui/src/shared_permission.rs
msgid "MailCraft isn't allowed to read other people's calendars yet."
msgstr "ל־MailCraft עדיין אין הרשאה לקרוא לוחות שנה של אנשים אחרים."

#. interface
#: crates/ui-egui/src/security.rs
msgid "MailCraft keeps at most {n} keys imported here, and has that many: remove one you don't use, then import this one."
msgstr "MailCraft שומר כאן לכל היותר {n} מפתחות מיובאים, וכבר הגיע למספר זה: הסר מפתח שאינך משתמש בו, ולאחר מכן ייבא מפתח זה."

#. interface
#: crates/ui-egui/src/account_setup.rs crates/ui-egui/src/dialogs.rs
msgid "MailCraft keeps it in memory until you close the app. It is never written to disk."
msgstr "MailCraft שומר זאת בזיכרון עד לסגירת היישום. המידע לעולם אינו נכתב לדיסק."

#. interface
#: crates/ui-egui/src/security.rs
msgid "MailCraft keeps the file, still protected by its passphrase, in the system's credential store. Only an ECDSA certificate (P-256 or P-384) is kept this way: an RSA one belongs on a smartcard or token (PKCS#11)."
msgstr "MailCraft שומר את הקובץ, כשהוא עדיין מוגן בביטוי הסיסמה שלו, במאגר פרטי ההתחברות של המערכת. רק אישור ECDSA ‏(P-256 או P-384) נשמר בדרך זו: אישור RSA מיועד לכרטיס חכם או אסימון (PKCS#11)."

#. interface
#: crates/ui-egui/src/forms.rs
msgid "MailCraft keeps this account's rules on this computer: the rule runs while MailCraft is open."
msgstr "MailCraft שומר את כללי החשבון הזה במחשב זה: הכלל פועל כל עוד MailCraft פתוח."

#. what a command says
#: crates/model/src/mailbox.rs crates/model/src/mailbox_bulk.rs
msgid "MailCraft moves a JMAP account's mail only between the folders its server has: the next Send/Receive would bring it back"
msgstr "MailCraft מעביר דואר של חשבון JMAP רק בין התיקיות הקיימות בשרת שלו: פעולת השליחה והקבלה הבאה תחזיר אותו"

#. interface
#: crates/ui-egui/src/auto_replies.rs
msgid "MailCraft needs you to sign in again to read your automatic replies: Microsoft's page opens in your browser. Mail and your calendar work as they are meanwhile."
msgstr "MailCraft צריך שתיכנס מחדש כדי לקרוא את התשובות האוטומטיות שלך: הדף של Microsoft ייפתח בדפדפן שלך. הדואר ולוח השנה שלך ימשיכו לפעול כרגיל בינתיים."

#. interface
#: crates/ui-egui/src/auto_replies.rs
msgid "MailCraft needs your permission to change your automatic replies first: File › Info › Ask again."
msgstr "כדי לשנות את התשובות האוטומטיות, MailCraft זקוק תחילה להרשאתך: קובץ › מידע › בקש שוב."

#. interface
#: crates/ui-egui/src/account_setup/help.rs
msgid "MailCraft needs your system browser to sign in. You can also use a Google app password."
msgstr "MailCraft זקוק לדפדפן המערכת שלך כדי לבצע כניסה. אפשר גם להשתמש בסיסמת אפליקציה של Google."

#. interface
#: crates/ui-egui/src/updates.rs
msgid "MailCraft now installs its updates itself. Turn this off in File › About."
msgstr "MailCraft מתקין כעת את עדכוניו בעצמו. אפשר לכבות זאת תחת קובץ › אודות."

#. name
#: crates/engine/src/cmd/rules.rs
msgid "MailCraft reaches this account's rules on the server once it switches to Microsoft Graph"
msgstr "MailCraft יגיע לכללים של חשבון זה בשרת לאחר שיעבור אל Microsoft Graph"

#. interface
#: crates/ui-egui/src/security.rs
msgid "MailCraft reads the key without its passphrase and keeps the file, still protected by it, in the system's credential store. The key must have a passphrase and sign with Ed25519 or ECDSA; MailCraft asks for the passphrase when you sign."
msgstr "MailCraft קורא את המפתח ללא ביטוי הסיסמה שלו ושומר את הקובץ, כשהוא עדיין מוגן בו, במאגר פרטי ההתחברות של המערכת. המפתח חייב להיות מוגן בביטוי סיסמה ולחתום באמצעות Ed25519 או ECDSA; MailCraft יבקש את ביטוי הסיסמה בעת החתימה."

#. interface
#: crates/ui-egui/src/reading/unsubscribe.rs
msgid "MailCraft sends {host} the address this list gave for unsubscribing, which may identify you to it, and nothing else: no cookies, no sign-in. Like any connection, it also shows your internet address."
msgstr "MailCraft שולח אל {host} את הכתובת שרשימת תפוצה זו מסרה להסרה מהרשימה, העשויה לזהות אותך מולה, ודבר מלבד זאת: ללא קובצי Cookie וללא כניסה לחשבון. כמו כל חיבור, הבקשה חושפת גם את כתובת האינטרנט שלך."

#. interface
#: crates/ui-egui/src/opening.rs
msgid "MailCraft starts with an empty mailbox and leaves the file as it is."
msgstr "MailCraft מתחיל עם תיבת דואר ריקה ומשאיר את הקובץ כפי שהוא."

#. interface
#: crates/ui-egui/src/opening.rs
msgid "MailCraft stopped reading it before it was done."
msgstr "MailCraft הפסיק לקרוא אותו לפני הסיום."

#. what a command says
#: crates/engine/src/import_pst.rs
msgid "MailCraft stopped reading the .pst file before it was done: what came in is kept"
msgstr "MailCraft הפסיק את קריאת קובץ ה־.pst לפני הסיום: מה שכבר יובא נשמר"

#. interface
#: crates/ui-egui/src/account_setup/exchange.rs
msgid "MailCraft tries the usual places for your address."
msgstr "MailCraft בודק את המיקומים המקובלים עבור כתובתך."

#. interface
#: crates/ui-egui/src/lib.rs
msgid "MailCraft was started with {n} thing that isn't a mail link or a file it opens: it was left alone"
msgid_plural "MailCraft was started with {n} things that aren't mail links or files it opens: they were left alone"
msgstr[0] "MailCraft הופעל עם פריט {n} שאינו קישור דואר או קובץ שהוא פותח: לא נעשה בו דבר"
msgstr[1] "MailCraft הופעל עם {n} פריטים שאינם קישורי דואר או קבצים שהוא פותח: לא נעשה בהם דבר"

#. interface
#: crates/ui-egui/src/server_sync.rs
msgid "MailCraft wasn't allowed to keep this mailbox in step with Outlook: {error}"
msgstr "ל־MailCraft לא ניתנה הרשאה לסנכרן תיבת דואר זו עם Outlook: {error}"

#. interface
#: crates/ui-egui/src/dialogs.rs
msgid "MailCraft will have no account afterwards: File › Add Account sets one up again."
msgstr "לאחר מכן לא יהיה ל־MailCraft אף חשבון: ״קובץ › הוסף חשבון״ יגדיר חשבון מחדש."

#. interface
#: crates/ui-egui/src/close_to_tray.rs
msgid "MailCraft will keep running"
msgstr "MailCraft ימשיך לפעול"

#. interface
#: crates/ui-egui/src/dialogs.rs
msgid "MailCraft will make one appointment called \"MailCraft connection check\" in the calendar of {account}, a year from today. It reads it back, changes its time twice (the second time said in this computer's time zone), reads it back each time, and deletes it again. Nothing else in your calendar is read or changed, nobody is invited or written to, and no reminder is set. Afterwards you see what the server answered at each step, and whether what was sent is what the server has."
msgstr "MailCraft ייצור פגישה אחת בשם \"MailCraft connection check\" בלוח השנה של {account}, בעוד שנה מהיום. הוא יקרא אותה בחזרה, ישנה את שעתה פעמיים (בפעם השנייה באזור הזמן של מחשב זה), יקרא אותה בכל פעם, וימחק אותה שוב. שום דבר אחר בלוח השנה שלך אינו נקרא או משתנה, איש אינו מוזמן ואינו מקבל הודעה, ולא מוגדרת תזכורת. לאחר מכן תוצג תשובת השרת בכל שלב, והאם מה שנשלח תואם למה ששמור בשרת."

#. android
#: apps/mailcraft-android/app/src/main/kotlin/work/mailcraft/android/Accounts.kt
msgid "MailCraft will read and change the shared mailboxes you have access to. Microsoft's page opens in your browser to ask you."
msgstr "MailCraft יקרא וישנה את תיבות הדואר המשותפות שיש לך גישה אליהן. הדף של Microsoft ייפתח בדפדפן שלך כדי לבקש את אישורך."

#. android
#: apps/mailcraft-android/app/src/main/kotlin/work/mailcraft/android/Accounts.kt
msgid "MailCraft will read and change your Microsoft To Do lists and tasks. Microsoft's page opens in your browser to ask you. Until you say yes, your tasks stay on this phone."
msgstr "MailCraft יקרא וישנה את רשימות ה־Microsoft To Do והמשימות שלך. הדף של Microsoft ייפתח בדפדפן שלך כדי לבקש את אישורך. עד שתאשר, המשימות שלך יישארו בטלפון זה."

#. android
#: apps/mailcraft-android/app/src/main/kotlin/work/mailcraft/android/Accounts.kt
msgid "MailCraft will send mail from a shared mailbox, as it or on its behalf. Microsoft's page opens in your browser to ask you."
msgstr "MailCraft ישלח דואר מתיבת דואר משותפת, כשולח עצמו או בשמו. הדף של Microsoft ייפתח בדפדפן שלך כדי לבקש את אישורך."

#. interface
#: crates/ui-egui/src/updates.rs
msgid "MailCraft {version} didn't start."
msgstr "MailCraft {version} לא הופעל."

#. interface
#: crates/ui-egui/src/updates.rs
msgid "MailCraft {version} is available"
msgstr "MailCraft {version} זמין"

#. interface
#: crates/ui-egui/src/updates.rs
msgid "MailCraft {version} is available and fixes a security problem"
msgstr "MailCraft {version} זמין ומתקן בעיית אבטחה"

#. interface
#: crates/ui-egui/src/updates.rs
msgid "MailCraft {version} wasn't installed: this version is still the one here."
msgstr "MailCraft {version} לא הותקן: גרסה זו עדיין מותקנת כאן."

#. interface
#: crates/ui-egui/src/account_setup.rs
msgid "MailCraft's Google Desktop registration is not yet configured for this build."
msgstr "רישום ה־Google Desktop של MailCraft עדיין אינו מוגדר בגרסה זו."

#. interface
#: crates/ui-egui/src/data_removal.rs
msgid "MailCraft's data has been removed already"
msgstr "הנתונים של MailCraft כבר הוסרו"

#. interface
#: crates/ui-egui/src/lib.rs
msgid "MailCraft's data has been removed: nothing is sent or received"
msgstr "הנתונים של MailCraft הוסרו: דבר אינו נשלח או מתקבל"

#. interface
#: crates/ui-egui/src/security.rs
msgid "MailCraft's search for your keys stopped without an answer. Try again."
msgstr "החיפוש של MailCraft אחר המפתחות שלך נעצר ללא תשובה. נסה שוב."

#. interface
#: crates/ui-egui/src/backstage.rs crates/ui-egui/src/folder_properties.rs crates/ui-egui/src/nav.rs
msgid "Mailbox"
msgstr "תיבת דואר"

#. interface
#: crates/ui-egui/src/signatures.rs
msgid "Make a signature with New."
msgstr "כדי ליצור חתימה, בחרו ב״חדש״."

#. command label
#: crates/ui-egui/src/lib.rs
msgid "Make an Item from a Message"
msgstr "צור פריט מהודעה"

#. interface
#: crates/ui-egui/src/forms.rs
msgid "Make it repeat…"
msgstr "הגדרת חזרה…"

#. interface
#: crates/ui-egui/src/signatures.rs
msgid "Make the signature from these details"
msgstr "יצירת החתימה מהפרטים האלה"

#. interface
#: crates/ui-egui/src/backstage.rs
msgid "Makes one test appointment a year from today in your account's calendar, changes it and deletes it again, and shows what the server answered"
msgstr "יוצר פגישת בדיקה אחת בעוד שנה מהיום בלוח השנה של החשבון שלך, משנה אותה ומוחק אותה שוב, ומציג את תשובת השרת"

#. ribbon, ribbon location
#: crates/engine/src/cmd/calendar.rs crates/engine/src/cmd/calendar_settings.rs crates/engine/src/cmd/calendar_subscribed.rs crates/ui-egui/src/ribbon.rs
msgid "Manage Calendars"
msgstr "נהל לוחות שנה"

#. command label, interface
#: crates/engine/src/cmd/rules.rs crates/ui-egui/src/backstage.rs
msgid "Manage Rules"
